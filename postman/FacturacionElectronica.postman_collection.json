{
  "info": {
    "name": "Facturacion Electronica - Flujo completo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "facturaId",
      "value": ""
    },
    {
      "key": "facturaRechazoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Config pública",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/config/public",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "config",
            "public"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Config 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"No expone secretos\", () => pm.expect(pm.response.text()).not.to.include(\"JWT_SECRET\"));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 Registrar cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreRazonSocial\": \"ParkSmart Demo\",\n  \"tipoIdentificacion\": \"CEDULA_JURIDICA\",\n  \"numeroIdentificacion\": \"3101999999\",\n  \"correo\": \"parksmart.demo@utn.local\",\n  \"telefono\": \"88888888\",\n  \"password\": \"ParkSmart2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Registro OK\", () => pm.expect(pm.response.code).to.be.oneOf([201,400]));",
              "if (pm.response.code === 201) { const d=pm.response.json(); pm.collectionVariables.set(\"accessToken\", d.accessToken); }"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"parksmart.demo@utn.local\",\n  \"password\": \"ParkSmart2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login 200\", () => pm.response.to.have.status(200));",
              "const d=pm.response.json(); pm.collectionVariables.set(\"accessToken\", d.accessToken);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
