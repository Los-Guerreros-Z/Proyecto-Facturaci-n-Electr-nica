    {
      "name": "12 Factura rechazada simulada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/facturas/procesar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "facturas",
            "procesar"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"RECHAZO-{{$timestamp}}\",\n  \"fecha\": \"2026-08-25T16:00:00\",\n  \"moneda\": \"CRC\",\n  \"condicionVenta\": \"CONTADO\",\n  \"medioPago\": \"SINPE\",\n  \"tipoDocumento\": \"FACTURA_ELECTRONICA\",\n  \"emisor\": {\"nombre\": \"ParkSmart Demo\", \"identificacion\": {\"tipo\": \"CEDULA_JURIDICA\", \"numero\": \"3101999999\"}, \"correo\": \"parksmart.demo@utn.local\"},\n  \"receptor\": {\"nombre\": \"Cliente Rechazo\", \"identificacion\": {\"tipo\": \"CEDULA_FISICA\", \"numero\": \"205550555\"}, \"correo\": \"rechazo@example.com\"},\n  \"items\": [{\"numeroLinea\": 1, \"detalle\": \"Servicio\", \"cantidad\": 1, \"precioUnitario\": 1000, \"descuento\": 0, \"impuesto\": {\"tarifa\": 13}, \"subtotal\": 1000, \"montoTotalLinea\": 1130}],\n  \"totales\": {\"totalGravado\": 1000, \"totalExento\": 0, \"totalDescuentos\": 0, \"totalImpuesto\": 130, \"totalComprobante\": 1130}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Factura rechazo creada\", () => pm.response.to.have.status(200));",
              "if (pm.response.code===200) pm.collectionVariables.set(\"facturaRechazoId\", pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
