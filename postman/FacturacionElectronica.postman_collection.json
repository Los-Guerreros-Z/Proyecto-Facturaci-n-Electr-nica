    {
      "name": "05 Procesar factura",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/facturas/procesar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "facturas",
            "procesar"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{$randomUUID}}\",\n  \"fecha\": \"2026-08-24T20:00:00\",\n  \"moneda\": \"CRC\",\n  \"condicionVenta\": \"01\",\n  \"medioPago\": \"01\",\n  \"tipoDocumento\": \"FACTURA_ELECTRONICA\",\n  \"emisor\": {\n    \"nombre\": \"ParkSmart Demo\",\n    \"identificacion\": {\n      \"tipo\": \"CEDULA_JURIDICA\",\n      \"numero\": \"3101999999\"\n    },\n    \"correo\": \"parksmart.demo@utn.local\"\n  },\n  \"receptor\": {\n    \"nombre\": \"Cliente Final\",\n    \"identificacion\": {\n      \"tipo\": \"CEDULA_FISICA\",\n      \"numero\": \"101110111\"\n    },\n    \"correo\": \"cliente@example.com\"\n  },\n  \"items\": [\n    {\n      \"numeroLinea\": 1,\n      \"detalle\": \"Servicio de estacionamiento\",\n      \"cantidad\": 1,\n      \"precioUnitario\": 1000,\n      \"descuento\": 0,\n      \"impuesto\": {\n        \"tarifa\": 13\n      },\n      \"subtotal\": 1000,\n      \"montoTotalLinea\": 1130\n    }\n  ],\n  \"totales\": {\n    \"totalGravado\": 1000,\n    \"totalExento\": 0,\n    \"totalDescuentos\": 0,\n    \"totalImpuesto\": 130,\n    \"totalComprobante\": 1130\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Factura 200\", () => pm.response.to.have.status(200));",
              "const d=pm.response.json(); pm.collectionVariables.set(\"facturaId\", d.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
